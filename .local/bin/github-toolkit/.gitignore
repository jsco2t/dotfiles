# Byte-compiled files and caches (generated by Python at runtime)
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# Type-checker and linter caches
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter checkpoints
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE settings
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
