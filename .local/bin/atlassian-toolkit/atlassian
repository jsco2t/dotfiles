def build_parser():
    p = argparse.ArgumentParser(
        prog="atlassian",
        description="Streamlined Atlassian Cloud CLI (Jira + Confluence). Compact output "
                    "by default; --json for structured output, --raw for the full API response.")
    p.add_argument("--version", action="version", version=f"atlassian-toolkit {VERSION}")
    sub = p.add_subparsers(dest="group", metavar="<group>")

    jp = sub.add_parser("jira", help="Jira issues, search, projects, users")
    jpsub = jp.add_subparsers(metavar="<command>")
    _group_default_help(jp)
    add_jira_commands(jpsub)

    cp = sub.add_parser("confluence", help="Confluence pages and search")
    cpsub = cp.add_subparsers(metavar="<command>")
    _group_default_help(cp)
    add_confluence_commands(cpsub)

    sg = sub.add_parser("search", help="search Jira + Confluence together")
    sg.add_argument("query")
    sg.add_argument("--limit", type=int, default=10)
    sg.add_argument("--json", action="store_true")
    sg.set_defaults(func=cmd_search_generic)

    a = sub.add_parser("auth", help="authenticate and manage saved credentials")
    asub = a.add_subparsers(metavar="<subcommand>")
    _group_default_help(a)
    al = asub.add_parser("login", help="log in and save an API token")
    al.add_argument("--site")
    al.add_argument("--email")
    al.add_argument("--token-stdin", action="store_true")
    al.set_defaults(func=cmd_auth_login)
    asub.add_parser("status", help="show current identity").set_defaults(func=cmd_auth_status)
    asub.add_parser("logout", help="remove saved credentials").set_defaults(func=cmd_auth_logout)

    d = sub.add_parser("doctor", help="check TLS, config, and connectivity")
    d.add_argument("--fix-ca", action="store_true")
    d.set_defaults(func=cmd_doctor)

    return p


def main(argv=None):
    from_cli = argv is None
    raw = sys.argv[1:] if from_cli else list(argv)
    prog = os.path.basename(sys.argv[0]) if from_cli else "atlassian"

    if raw[:1] == ["--version"]:
        print(f"atlassian-toolkit {VERSION}")
        return
    # multi-call dispatch: `jira ...` / `confluence ...` inject their group
    if prog in ("jira", "confluence"):
        raw = [prog] + raw

    parser = build_parser()
    args = parser.parse_args(raw)
    func = getattr(args, "func", None)
    if not func:
        parser.print_help()
        sys.exit(EX_USAGE)
    try:
        func(args)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        finally:
            os._exit(EX_OK)


if __name__ == "__main__":
    main()
