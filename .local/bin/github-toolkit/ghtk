def cmd_auth_login(args):
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    try:
        if args.token_stdin:
            token = sys.stdin.readline().strip()
        elif not token:
            token = getpass.getpass("GitHub token (create at https://github.com/settings/tokens): ").strip()
    except EOFError:
        die(EX_USAGE, "no interactive terminal available for `auth login`. Run it in a normal terminal, "
                      "or pipe the token with --token-stdin, or just set GITHUB_TOKEN / use `gh auth login`.")
    if not token:
        die(EX_USAGE, "a token is required")
    global _TOKEN_CACHE
    _TOKEN_CACHE = (token, "login")
    me = rest("GET", "/user")
    save_auth(token)
    if args.json:
        return jdump({"login": me.get("login"), "saved": str(AUTH_FILE)})
    print(f"authenticated as {me.get('login')}")
    print(f"token saved to {AUTH_FILE} (chmod 600)")


def cmd_auth_status(args):
    token, source = load_token(require=False)
    if not token:
        die(EX_AUTH, "not authenticated. Set GITHUB_TOKEN, run `gh auth login`, or `ghtk auth login`.")
    me = rest("GET", "/user", soft=True)
    if me is None:
        die(EX_AUTH, f"token found (source: {source}) but /user failed -- it may be invalid or expired")
    if args.json:
        return jdump({"login": me.get("login"), "source": source})
    print(f"login:  {me.get('login')}")
    print(f"source: {source}")


def cmd_auth_logout(args):
    existed = AUTH_FILE.exists()
    if existed:
        AUTH_FILE.unlink()
    if args.json:
        return jdump({"removed": existed, "path": str(AUTH_FILE)})
    print(f"removed {AUTH_FILE}" if existed else "no saved credentials (env / gh tokens are managed elsewhere)")


def cmd_doctor(args):
    ca_removed = None
    if args.fix_ca:
        try:
            CA_CACHE.unlink()
            ca_removed = True
        except FileNotFoundError:
            ca_removed = False
        except OSError as e:
            ca_removed = False
            if not args.json:
                eprint(f"could not remove {CA_CACHE}: {e}")
    ctx = build_ssl_context()
    n = ctx.cert_store_stats().get("x509", 0)
    token, source = load_token(require=False)
    login, github_ok = None, None
    if token:
        me = rest("GET", "/user", soft=True)
        github_ok = me is not None
        login = me.get("login") if me else None

    if args.json:
        out = {"version": VERSION, "python": platform.python_version(), "platform": platform.system(),
               "ca_certs": n, "token_source": source, "github_ok": github_ok, "login": login}
        if ca_removed is not None:
            out["ca_cache_removed"] = ca_removed
        jdump(out)
        if token and github_ok is False:
            sys.exit(EX_NET)
        return

    if ca_removed is True:
        print(f"removed cached CA bundle {CA_CACHE}")
    elif ca_removed is False and args.fix_ca:
        print("no cached CA bundle to remove")
    print(f"github-toolkit {VERSION}")
    print(f"python:  {platform.python_version()} ({platform.system()})")
    if n:
        print(f"TLS CA:  {n} certificate(s) loaded")
    else:
        print("TLS CA:  0 certificates  [!] empty trust store -- HTTPS will fail")
        print("         fix: install CA certs (Debian: apt-get install -y ca-certificates; "
              "Rocky/RHEL: dnf install -y ca-certificates),")
        print("              or `pip install certifi`, or set GITHUB_CA_BUNDLE=/path/to/ca-bundle.crt")
    if not token:
        print("auth:    not configured  -> set GITHUB_TOKEN, run `gh auth login`, or `ghtk auth login`")
        return
    print(f"token:   present (source: {source})")
    if github_ok:
        print(f"github:  OK -- {login}  (api.github.com reachable)")
    else:
        print("github:  FAILED -- /user did not return 200 (token invalid/expired, or network; "
              "if it only fails in a sandbox the CA fix above should have handled it)")
        sys.exit(EX_NET)


