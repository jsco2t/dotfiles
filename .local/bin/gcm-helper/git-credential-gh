#!/bin/sh
# Git credential helper that runs `gh auth git-credential` for github.com and
# gist.github.com. It finds gh on PATH first, then in the Homebrew prefixes,
# because git may run it from a shell without the Homebrew bin on PATH. It exits
# 0 without output when gh is not installed, so git moves on to its own prompt.

set -eu

gh=$(command -v gh) || gh=

if [ -z "$gh" ]; then
	for prefix in /home/linuxbrew/.linuxbrew /opt/homebrew /usr/local; do
		if [ -f "$prefix/bin/gh" ] && [ -x "$prefix/bin/gh" ]; then
			gh="$prefix/bin/gh"
			break
		fi
	done
fi

if [ -z "$gh" ]; then
	exit 0
fi

exec "$gh" auth git-credential "$@"
