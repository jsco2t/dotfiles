def cmd_conf_page(args):
    pid = parse_confluence_id(args.page)
    data = api_request("GET", f"/wiki/api/v2/pages/{pid}", params={"body-format": "atlas_doc_format"})
    title = data.get("title", "")
    adf = (data.get("body", {}).get("atlas_doc_format") or {}).get("value")
    if adf:
        try:
            text = adf_to_text(json.loads(adf))
        except json.JSONDecodeError:
            text = adf
    else:  # fall back to storage (XHTML) for pages without ADF
        data2 = api_request("GET", f"/wiki/api/v2/pages/{pid}", params={"body-format": "storage"})
        text = html_to_text((data2.get("body", {}).get("storage") or {}).get("value", ""))
    if args.json:
        return jdump({"id": pid, "title": title, "text": text})
    print(f"# {title}  (id {pid})")
    print(truncate(text, args.full) if text else "(empty)")


def cmd_conf_descendants(args):
    pid = parse_confluence_id(args.page)
    res = api_request("GET", f"/wiki/api/v2/pages/{pid}/children", params={"limit": args.limit})
    results = res.get("results", [])
    if args.json:
        return jdump(results)
    if not results:
        print("(no child pages)")
        return
    for c in results:
        print(f"{c.get('id')}  {c.get('title')}")


def cmd_conf_search(args):
    cql = args.query if args.cql else f'text ~ "{args.query}"'
    res = api_request("GET", "/wiki/rest/api/search", params={"cql": cql, "limit": args.limit})
    results = res.get("results", [])
    if args.json:
