#!/bin/sh
# Git credential helper that runs Git Credential Manager (GCM) from
# ~/.local/bin/git-credential-manager. It exits 0 without output when GCM is
# not installed, so git moves on to its own prompt.
#
# On Linux, GCM has no default credential store, so this wrapper selects the
# in-memory cache store when GCM_CREDENTIAL_STORE is unset. On macOS it leaves
# the variable alone, so GCM keeps its Keychain default.

set -eu

gcm="$HOME/.local/bin/git-credential-manager"

if [ ! -f "$gcm" ] || [ ! -x "$gcm" ]; then
	exit 0
fi

if [ -z "${GCM_CREDENTIAL_STORE+set}" ] && [ "$(uname 2>/dev/null)" = Linux ]; then
	GCM_CREDENTIAL_STORE=cache
	export GCM_CREDENTIAL_STORE
fi

exec "$gcm" "$@"
