{
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
    "CLAUDE_CODE_SUPPRESS_SESSION_ATTRIBUTION": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "10"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go run *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo run *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(make *)",
      "Bash(mage *)",
      "Bash(grep *)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cat:*)",
      "Bash(cut:*)",
      "Bash(column:*)",
      "Bash(nl:*)",
      "Bash(tac:*)",
      "Bash(rev:*)",
      "Bash(fold:*)",
      "Bash(comm:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(rg:*)",
      "Bash(less:*)",
      "Bash(tree:*)",
      "Bash(python3 */.claude/skills/copilot-fixer/*)",
      "Bash(find:*)",
      "Bash(pre-commit:*)",
      "Bash(* ./mage *)",
      "Bash(git diff:*)",
      "Bash(cargo:*)",
      "Bash(rustfmt:*)",
      "Bash(clippy:*)",
      "Read(~/Developer/sources/personal/notebook/**)",
      "Edit(~/Developer/sources/personal/notebook/projects/substrate/**)",
      "Edit(~/Developer/sources/personal/notebook/projects/fuzzball/**)",
      "Edit(~/Developer/sources/personal/notebook/**)",
      "Bash(python3 ~/.claude/skills/task-pipeline/scripts/tp.py:*)",
      "Bash(jira search:*)",
      "Bash(jira issue get:*)",
      "Bash(jira issue links:*)",
      "Bash(jira issue comments:*)",
      "Bash(jira issue history:*)",
      "Bash(confluence page:*)",
      "Bash(confluence search:*)",
      "Bash(confluence descendants:*)",
      "Bash(atlassian search:*)",
      "Bash(ghtk pr get:*)",
      "Bash(ghtk pr diff:*)",
      "Bash(ghtk pr threads:*)",
      "Bash(ghtk pr checks:*)",
      "Bash(ghtk issue get:*)",
      "Bash(ghtk commit prs:*)",
      "Bash(ghtk workflow list:*)",
      "Bash(ghtk workflow runs:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read($HOME/.ssh)",
      "Read($HOME/.kube)",
      "Read($HOME/.aws)",
      "Read($HOME/.dotfiles)",
      "Edit($HOME/.ssh)",
      "Edit($HOME/.kube)",
      "Edit($HOME/.aws)",
      "Edit($HOME/.dotfiles)",
      "Read(~/.ssh)",
      "Read(~/.kube)",
      "Read(~/.aws)",
      "Read(~/.dotfiles)",
      "Edit(~/.ssh)",
      "Edit(~/.kube)",
      "Edit(~/.aws)",
      "Edit(~/.dotfiles)",
      "Edit(rm -rf *)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(git commit:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "skillOverrides": {
    "code-review": "off"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "claude-nod evaluate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/allow-safe-pipes.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jscott/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": []
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": []
      }
    ],
    "SubagentStart": [
      {
        "hooks": []
      }
    ],
    "SubagentStop": [
      {
        "hooks": []
      }
    ],
    "Stop": [
      {
        "hooks": []
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/env python3 $HOME/.claude/statusline.py"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache/go-build",
        "~/go/pkg/mod",
        "~/.magefile/",
        "~/.cache/",
        "$HOME/.cache/go-build",
        "$HOME/go/pkg/mod",
        "$HOME/.magefile/",
        "$HOME/.cache/"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "advisorModel": "claude-opus-5-5",
  "skipWorkflowUsageWarning": true,
  "network": {
    "allowed_domains": [
      "pkg.go.dev",
      "*.go.dev",
      "*.githubusercontent.com",
      "*.github.com",
      "crates.io",
      "*.crates.io",
      "docs.rs",
      "*.docs.rs",
      "*.atlassian.net"
    ]
  }
}