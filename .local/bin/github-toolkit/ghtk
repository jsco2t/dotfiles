def _load_comments_file(path):
    try:
        data = json.loads(sys.stdin.read() if path == "-" else Path(path).read_text())
    except (OSError, json.JSONDecodeError) as e:
        die(EX_USAGE, f"could not read comments file {path}: {e}")
    if not isinstance(data, list):
        die(EX_USAGE, "comments file must be a JSON array of {path,line,body[,side,start_line]}")
    return data


def _build_review_comment(c, marker):
    body = c.get("body", "")
    if marker and marker not in body:
        body = f"{marker}\n{body}"
    out = {"path": c["path"], "body": body}
    for k_in, k_out in (("line", "line"), ("side", "side"), ("start_line", "start_line"), ("start_side", "start_side")):
        if c.get(k_in) is not None:
            out[k_out] = c[k_in]
    return out


def cmd_pr_comment(args):
    owner, repo, num, pr = resolve_pr(args, need_obj=True)
    sha = (pr.get("head") or {}).get("sha")
    raw = _load_comments_file(args.comments_file)
    comments = [_build_review_comment(c, args.marker) for c in raw]
    payload = {"commit_id": sha, "event": "COMMENT", "comments": comments}
    path = f"/repos/{owner}/{repo}/pulls/{num}/reviews"
    if args.dry_run:
        print(f"DRY RUN: POST {API_ROOT}{path}")
        print(json.dumps(payload, indent=2))
        return
    try:
        _post(path, payload)
        print(f"posted review with {len(comments)} comment(s) to #{num}")
        return
    except ApiNetError as e:
        die(EX_NET, _cert_help(e.exc) if e.cert else _net_help(e.exc))
    except ApiHTTPError as e:
        # ONLY a 422 for lines outside the diff triggers the per-comment fallback. Auth (403),
        # not-found (404), and rate-limit are real failures -- never masquerade as "dropped".
        if not (e.code == 422 and "diff" in (e.body or "").lower()):
            _raise_http(e)
    # Fallback: re-post each comment on its own; out-of-diff lines 422 (dropped), valid ones land.
    posted, dropped = 0, []
    for c in comments:
        single = dict(c, commit_id=sha)
        try:
            _post(f"/repos/{owner}/{repo}/pulls/{num}/comments", single)
            posted += 1
        except ApiHTTPError as e:
            if e.code == 422:
                dropped.append(f"{c.get('path')}:{c.get('line')}")
            else:
                _raise_http(e)
        except ApiNetError as e:
            die(EX_NET, _cert_help(e.exc) if e.cert else _net_help(e.exc))
    result = {"posted": posted, "dropped": len(dropped), "dropped_locations": dropped}
    if args.json:
        jdump(result)
    else:
        print(f"posted {posted} comment(s) to #{num}" + (f"; dropped {len(dropped)}: {', '.join(dropped)}" if dropped else ""))
    if posted == 0:
        sys.exit(EX_API)  # nothing landed -- signal failure, do not exit 0


