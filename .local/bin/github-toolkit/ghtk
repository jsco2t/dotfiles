def _group_default_help(parser):
    parser.set_defaults(func=lambda a, _p=parser: _p.print_help())


def _repo_parent():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("--repo", "-R", metavar="OWNER/REPO",
                   help="target repo, usable in any position (default: the git 'origin' remote)")
    return p


def add_pr_commands(sp, repo_parent):
    g = sp.add_parser("get", parents=[repo_parent], help="resolve a PR (URL / number / current branch)")
    g.add_argument("ref", nargs="?", help="PR URL, number, #number, or omit for the current branch")
    g.add_argument("--json", action="store_true")
    g.add_argument("--raw", action="store_true")
    g.set_defaults(func=cmd_pr_get)

    d = sp.add_parser("diff", parents=[repo_parent], help="unified diff (or --name-only file list)")
    d.add_argument("ref", nargs="?")
    d.add_argument("--name-only", action="store_true", help="list changed file paths only")
    d.add_argument("--json", action="store_true")
    d.set_defaults(func=cmd_pr_diff)

    fl = sp.add_parser("files", parents=[repo_parent], help="changed files with stats")
    fl.add_argument("ref", nargs="?")
    fl.add_argument("--json", action="store_true")
    fl.set_defaults(func=cmd_pr_files)

    t = sp.add_parser("threads", parents=[repo_parent], help="review threads (GraphQL)")
    t.add_argument("ref", nargs="?")
    t.add_argument("--unresolved-only", action="store_true")
    t.add_argument("--include-outdated", action="store_true", help="keep outdated threads (dropped by default)")
    t.add_argument("--mine-only", action="store_true", help="only threads containing --marker")
    t.add_argument("--marker", help="hidden marker string identifying this skill's comments")
    t.add_argument("--author-substr", help="only threads whose FIRST comment author login contains this")
