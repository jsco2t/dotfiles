def cmd_issue_transition(args):
    res = api_request("GET", f"/rest/api/{API}/issue/{args.key}/transitions")
    transitions = res.get("transitions", [])
    if not args.to:
        if args.json:
            return jdump(transitions)
        if not transitions:
            print("(no transitions available)")
            return
        print(f"Available transitions for {args.key}:")
        for t in transitions:
            print(f"- {t.get('name')}  -> {name_of(t.get('to'))}")
        return
    match = next((t for t in transitions if t.get("name", "").lower() == args.to.lower()), None)
    if not match:
        names = ", ".join(t.get("name", "") for t in transitions) or "(none)"
        die(EX_USAGE, f"no transition named '{args.to}' for {args.key}. Available: {names}")
    api_request("POST", f"/rest/api/{API}/issue/{args.key}/transitions",
                body={"transition": {"id": match["id"]}}, expect_json=False)
    print(f"{args.key} -> {match.get('name')}")


def cmd_issue_links(args):
    links = api_request("GET", f"/rest/api/{API}/issue/{args.key}/remotelink")
    if args.json:
