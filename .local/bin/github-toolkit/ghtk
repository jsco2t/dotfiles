FAIL_CONCLUSIONS = {"failure", "timed_out", "action_required", "cancelled", "stale", "startup_failure"}
PASS_CONCLUSIONS = {"success", "neutral", "skipped"}


def _bucket_check_run(cr):
    if cr.get("status") != "completed":
        return "pending"
    return "fail" if cr.get("conclusion") in FAIL_CONCLUSIONS else "pass"


def _bucket_status(state):
    return {"success": "pass", "pending": "pending"}.get(state, "fail")  # failure/error -> fail


def _collect_checks(owner, repo, sha):
    """Merge Actions check-runs AND legacy commit statuses into one list.
    Querying only check-runs would make status-only CI look green (a real trap)."""
    runs, _ = rest_all(f"/repos/{owner}/{repo}/commits/{sha}/check-runs",
                       params={"per_page": 100}, container_key="check_runs")
    checks = [{"name": cr.get("name"), "type": "check_run", "bucket": _bucket_check_run(cr),
               "conclusion": cr.get("conclusion"), "status": cr.get("status"),
               "link": cr.get("details_url"), "details_url": cr.get("details_url"),
               "app": (cr.get("app") or {}).get("slug")} for cr in runs]
    combined = rest("GET", f"/repos/{owner}/{repo}/commits/{sha}/status", params={"per_page": 100})
    seen = set()
    for st in (combined.get("statuses") or []):
        ctx = st.get("context")
        if ctx in seen:
            continue
        seen.add(ctx)
        checks.append({"name": ctx, "type": "status", "bucket": _bucket_status(st.get("state")),
                       "conclusion": st.get("state"), "status": st.get("state"),
                       "link": st.get("target_url"), "details_url": st.get("target_url"), "app": None})
    return checks


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None


def _fetch_job_log_text(path):
    """GET a job-logs endpoint that 302-redirects to signed blob storage. urllib would
    forward the Authorization header to the blob host (-> 401), so follow the redirect
    manually WITHOUT auth. The CA context must be on the opener (build_opener's default
    HTTPS handler uses the possibly-empty system store). Returns text or None."""
    ctx = build_ssl_context()
    opener = urllib.request.build_opener(urllib.request.HTTPSHandler(context=ctx), _NoRedirect)
    try:
        with opener.open(urllib.request.Request(_url(path), headers=_headers()), timeout=DEFAULT_TIMEOUT) as r:
            return r.read().decode("utf-8", "replace")  # GHES may return logs directly
    except urllib.error.HTTPError as e:
        if e.code in (301, 302, 303, 307, 308) and e.headers.get("Location"):
            try:
                loc = urllib.request.Request(e.headers["Location"], headers={"User-Agent": USER_AGENT})
                with urllib.request.urlopen(loc, timeout=DEFAULT_TIMEOUT, context=ctx) as r2:
                    return r2.read().decode("utf-8", "replace")
            except Exception:
                return None
        return None
    except (urllib.error.URLError, ssl.SSLError, http.client.HTTPException, ConnectionError, OSError):
        return None


def _job_logs(owner, repo, details_url):
    """Failed-job logs for an Actions check run, via .../jobs/{id}/logs (302 -> plaintext)."""
    m = re.search(r"/job/(\d+)", details_url or "")
    job_ids = [m.group(1)] if m else []
    if not job_ids:  # only a run id in the URL: list its failed jobs
        mr = re.search(r"/runs/(\d+)", details_url or "")
        if not mr:
            return None
        jobs, _ = rest_all(f"/repos/{owner}/{repo}/actions/runs/{mr.group(1)}/jobs",
                           params={"per_page": 100, "filter": "latest"}, container_key="jobs", soft=True)
        job_ids = [str(j.get("id")) for j in jobs if j.get("conclusion") in FAIL_CONCLUSIONS]
    chunks = []
    for jid in job_ids[:5]:
        text = _fetch_job_log_text(f"/repos/{owner}/{repo}/actions/jobs/{jid}/logs")
        if text:
            chunks.append(text[-5000:] if len(text) > 5000 else text)
    return "\n---\n".join(chunks) if chunks else None


def cmd_pr_checks(args):
    owner, repo, num, pr = resolve_pr(args, need_obj=True)
    sha = (pr.get("head") or {}).get("sha")
    checks = _collect_checks(owner, repo, sha)
    if args.failing_only:
        checks = [c for c in checks if c["bucket"] == "fail"]
    summary = {"total": len(checks),
               "pass": sum(c["bucket"] == "pass" for c in checks),
               "fail": sum(c["bucket"] == "fail" for c in checks),
               "pending": sum(c["bucket"] == "pending" for c in checks)}
    if args.logs:
        for c in checks:
            if c["bucket"] == "fail" and c["type"] == "check_run":
                c["logs"] = _job_logs(owner, repo, c.get("details_url"))
    if args.json:
        return jdump({"sha": sha, "summary": summary, "checks": checks})
    for c in checks:
        print(f"{c['bucket']:<8} {c['type']:<10} {c['name']}  ({c['conclusion'] or c['status']})")
        if args.logs and c.get("logs"):
            print("  --- failed job logs (tail) ---")
            for line in c["logs"].splitlines()[-40:]:
                print(f"  {line}")
    print(f"total={summary['total']} pass={summary['pass']} fail={summary['fail']} pending={summary['pending']}")


