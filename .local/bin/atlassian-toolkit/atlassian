# commands: auth
# --------------------------------------------------------------------------- #
def cmd_auth_login(args):
    site = args.site or os.environ.get("ATLASSIAN_SITE") or os.environ.get("JIRA_SITE")
    email = args.email or os.environ.get("ATLASSIAN_EMAIL") or os.environ.get("JIRA_EMAIL")
    token = os.environ.get("ATLASSIAN_API_TOKEN") or os.environ.get("JIRA_API_TOKEN")
    try:
        if not site:
            site = input("Site (e.g. your-org.atlassian.net): ").strip()
        if not email:
            email = input("Email: ").strip()
        if args.token_stdin:
            token = sys.stdin.readline().strip()
        elif not token:
            token = getpass.getpass("API token (create at https://id.atlassian.com/manage-profile/security/api-tokens): ").strip()
    except EOFError:
        die(EX_USAGE,
            "no interactive terminal available for `auth login`. Run it in a normal terminal, or provide "
            "values non-interactively: pass --site and --email with ATLASSIAN_API_TOKEN set in the "
            "environment (optionally --token-stdin to pipe the token).")
    if not (site and email and token):
        die(EX_USAGE, "site, email, and token are all required")
    base_url = normalize_base_url(site)
    os.environ["ATLASSIAN_SITE"], os.environ["ATLASSIAN_EMAIL"], os.environ["ATLASSIAN_API_TOKEN"] = base_url, email, token
    me = api_request("GET", f"/rest/api/{API}/myself")
    save_auth(base_url, email, token)
    print(f"authenticated as {me.get('displayName')} <{me.get('emailAddress','')}> at {base_url}")
    print(f"credentials saved to {AUTH_FILE} (chmod 600)")


def cmd_auth_status(args):
    base_url, email, token = load_auth(require=False)
    if not (base_url and email and token):
        die(EX_AUTH, "not authenticated. Run: atlassian auth login")
    source = "environment" if (os.environ.get("ATLASSIAN_API_TOKEN") or os.environ.get("JIRA_API_TOKEN")) else str(AUTH_FILE)
    me = api_request("GET", f"/rest/api/{API}/myself")
    print(f"site:     {base_url}")
    print(f"email:    {email}")
    print(f"identity: {me.get('displayName')} ({me.get('accountId')})")
    print(f"source:   {source}")


def cmd_auth_logout(args):
    if AUTH_FILE.exists():
        AUTH_FILE.unlink()
        print(f"removed {AUTH_FILE}")
    else:
        print("no saved credentials")


