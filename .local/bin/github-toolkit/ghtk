def cmd_pr_scan(args):
    owner, repo = resolve_repo(getattr(args, "repo", None))
    prs, _ = rest_all(f"/repos/{owner}/{repo}/pulls", params={"state": "open", "per_page": 100},
                      cap=args.limit if args.limit else None)
    out = []
    for pr in prs:
        num = pr.get("number")
        if args.drop_drafts and pr.get("draft"):
            continue
        row = {"number": num, "url": pr.get("html_url"), "title": pr.get("title"),
               "author": (pr.get("user") or {}).get("login"), "isDraft": pr.get("draft")}
        if args.drop_human_reviewed:
            if any(r["type"] == "User" for r in _fetch_reviews(owner, repo, num)):
                continue
        if args.file_glob:
            files, _ = rest_all(f"/repos/{owner}/{repo}/pulls/{num}/files", params={"per_page": 100})
            names = [f.get("filename", "") for f in files]
            per_file = [any(fnmatch.fnmatch(n, g) for g in args.file_glob) for n in names]
            keep = (bool(per_file) and all(per_file)) if args.all_files_match else any(per_file)
            if not keep:
                continue
            row["file_count"] = len(names)
        if args.drop_ci_failing:
            sha = (pr.get("head") or {}).get("sha")
            if any(c["bucket"] == "fail" for c in _collect_checks(owner, repo, sha)):
                continue
            row["ci_status"] = "not-failing"
        out.append(row)
    if args.json:
        return jdump({"prs": out, "count": len(out)})
    if not out:
        print("(no matching open PRs)")
        return
    for r in out:
        print(f"#{r['number']:<6} {r['author']:<18} {r['title']}")
    print(f"({len(out)} PR{'s' if len(out) != 1 else ''})")


