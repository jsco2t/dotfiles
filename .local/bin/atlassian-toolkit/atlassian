def cmd_search(args):
    fields = args.fields.split(",") if args.fields else list(DEFAULT_SEARCH_FIELDS)
    limit = args.limit
    collected = []
    page_token = None
    while True:
        body = {"jql": args.jql, "maxResults": min(100, limit - len(collected)), "fields": fields}
        if page_token:
            body["nextPageToken"] = page_token
        res = api_request("POST", f"/rest/api/{API}/search/jql", body=body)
        collected.extend(res.get("issues", []))
        page_token = res.get("nextPageToken")
        if res.get("isLast") or not page_token or len(collected) >= limit:
            break
    collected = collected[:limit]
    if args.raw:
        return jdump({"issues": collected})
    if args.json:
        return jdump([{"key": i.get("key"), "status": name_of(i.get("fields", {}).get("status")),
                       "type": name_of(i.get("fields", {}).get("issuetype")),
                       "summary": i.get("fields", {}).get("summary"),
                       "assignee": name_of(i.get("fields", {}).get("assignee")),
                       "updated": short_date(i.get("fields", {}).get("updated"))} for i in collected])
    if not collected:
        print("(no issues)")
        return
    for i in collected:
        print(issue_line(i))
    print(f"({len(collected)} issue{'s' if len(collected) != 1 else ''})")


