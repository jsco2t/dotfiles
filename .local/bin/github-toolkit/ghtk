def build_parser():
    p = argparse.ArgumentParser(
        prog="ghtk",
        description="Streamlined GitHub CLI (PRs, issues, reviews, CI). stdlib-only, sandbox-friendly. "
                    "Compact output by default; --json for structured output.")
    p.add_argument("--version", action="version", version=f"github-toolkit {VERSION}")
    sub = p.add_subparsers(dest="group", metavar="<group>")
    repo_parent = _repo_parent()

    pr = sub.add_parser("pr", help="pull requests: get, diff, files, threads, reviews, checks, scan, comment, reply, resolve, create")
    prsub = pr.add_subparsers(metavar="<command>")
    _group_default_help(pr)
    add_pr_commands(prsub, repo_parent)

    iss = sub.add_parser("issue", help="issues")
    isub = iss.add_subparsers(metavar="<command>")
    _group_default_help(iss)
    ig = isub.add_parser("get", parents=[repo_parent], help="fetch an issue (or PR) body and comments")
    ig.add_argument("ref", help="issue number, #number, or URL")
    ig.add_argument("--comments", action="store_true")
    ig.add_argument("--json", action="store_true")
    ig.add_argument("--raw", action="store_true")
    ig.set_defaults(func=cmd_issue_get)

    com = sub.add_parser("commit", help="commit lookups")
    csub = com.add_subparsers(metavar="<command>")
    _group_default_help(com)
    cp = csub.add_parser("prs", parents=[repo_parent], help="PRs that introduced a commit")
    cp.add_argument("sha", help="commit sha (full or abbreviated)")
    cp.add_argument("--json", action="store_true")
    cp.set_defaults(func=cmd_commit_prs)

    a = sub.add_parser("auth", help="authenticate and manage the saved token")
    asub = a.add_subparsers(metavar="<subcommand>")
    _group_default_help(a)
    al = asub.add_parser("login", help="save a GitHub token")
    al.add_argument("--token-stdin", action="store_true")
    al.add_argument("--json", action="store_true")
    al.set_defaults(func=cmd_auth_login)
    ast_ = asub.add_parser("status", help="show current identity and token source")
    ast_.add_argument("--json", action="store_true")
    ast_.set_defaults(func=cmd_auth_status)
    alo = asub.add_parser("logout", help="remove the saved token")
    alo.add_argument("--json", action="store_true")
    alo.set_defaults(func=cmd_auth_logout)

    d = sub.add_parser("doctor", help="check TLS, token, and api.github.com reachability")
    d.add_argument("--fix-ca", action="store_true")
    d.add_argument("--json", action="store_true")
    d.set_defaults(func=cmd_doctor)

    return p


def _extract_repo(raw):
    """Pull a universal --repo/-R (and value) out of argv, in any position, so it never
    collides with a trailing `nargs='?'` positional in a subparser (an argparse quirk where
    `--repo X <ref>` drops <ref>). Returns (repo_or_None, remaining_argv)."""
    repo, out, i = None, [], 0
    while i < len(raw):
        a = raw[i]
        if a in ("--repo", "-R") and i + 1 < len(raw):
            repo = raw[i + 1]
            i += 2
            continue
        if a.startswith("--repo="):
            repo = a[len("--repo="):]
            i += 1
            continue
        if a.startswith("-R") and not a.startswith("--") and len(a) > 2:
            repo = a[2:]
            i += 1
            continue
        out.append(a)
        i += 1
    return repo, out


def main(argv=None):
    global _REPO_OVERRIDE
    from_cli = argv is None
    raw = sys.argv[1:] if from_cli else list(argv)
    if raw[:1] == ["--version"]:
        print(f"github-toolkit {VERSION}")
        return
    _REPO_OVERRIDE, raw = _extract_repo(raw)
    parser = build_parser()
    args = parser.parse_args(raw)
    func = getattr(args, "func", None)
    if not func:
        parser.print_help()
        sys.exit(EX_USAGE)
    try:
        func(args)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        finally:
            os._exit(EX_OK)


if __name__ == "__main__":
    main()
