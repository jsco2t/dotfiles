def cmd_me(args):
    me = api_request("GET", f"/rest/api/{API}/myself")
    if args.json:
        return jdump(me)
    print(f"{me.get('displayName')} <{me.get('emailAddress','')}>")
    print(f"accountId: {me.get('accountId')}")


def cmd_user(args):
    users = api_request("GET", f"/rest/api/{API}/user/search",
                        params={"query": args.query, "maxResults": args.limit})
    if args.json:
        return jdump(users)
    if not users:
        print("(no users)")
        return
    for u in users:
        print(f"{u.get('accountId')}  {u.get('displayName')}  <{u.get('emailAddress','')}>")


def cmd_project_list(args):
    params = {"maxResults": args.limit}
    if args.search:
        params["query"] = args.search
    res = api_request("GET", f"/rest/api/{API}/project/search", params=params)
    values = res.get("values", res if isinstance(res, list) else [])
    if args.json:
        return jdump(values)
    if not values:
        print("(no projects)")
        return
    for p in values:
        print(f"{p.get('key'):<12} {p.get('name')}")


def cmd_project_types(args):
    res = api_request("GET", f"/rest/api/{API}/issue/createmeta/{args.project}/issuetypes")
    types = res.get("issueTypes", res.get("values", []))
    if args.json:
        return jdump(types)
    if not types:
        print("(no issue types)")
        return
    for it in types:
        print(f"{it.get('name')}{' (subtask)' if it.get('subtask') else ''}")


# --------------------------------------------------------------------------- #
# commands: jira - issue
# --------------------------------------------------------------------------- #
def cmd_issue_get(args):
    fields = args.fields.split(",") if args.fields else list(DEFAULT_ISSUE_FIELDS)
    if args.description and "description" not in fields:
        fields.append("description")
    if args.comments:
        fields.append("comment")
    issue = api_request("GET", f"/rest/api/{API}/issue/{args.key}", params={"fields": ",".join(fields)})
    if args.raw:
        return jdump(issue)
    f = issue.get("fields", {})
    if args.json:
        out = {"key": issue.get("key"), "status": name_of(f.get("status")),
               "type": name_of(f.get("issuetype")), "summary": f.get("summary"),
               "assignee": name_of(f.get("assignee")), "reporter": name_of(f.get("reporter")),
               "priority": name_of(f.get("priority")), "labels": f.get("labels", []),
               "updated": short_date(f.get("updated"))}
        if args.description:
            out["description"] = adf_to_text(f.get("description"))
        return jdump(out)
    print(f"{issue.get('key')}  {name_of(f.get('issuetype'))}  {name_of(f.get('status'))}")
    print(f"Summary:  {f.get('summary','')}")
    line = f"Assignee: {name_of(f.get('assignee')) or 'Unassigned'}"
    if f.get("reporter"):
        line += f"   Reporter: {name_of(f.get('reporter'))}"
    if f.get("priority"):
        line += f"   Priority: {name_of(f.get('priority'))}"
    print(line)
    meta = f"Updated:  {short_date(f.get('updated'))}"
    if f.get("labels"):
        meta += f"   Labels: {', '.join(f['labels'])}"
    print(meta)
    if args.description:
        desc = adf_to_text(f.get("description")).strip()
        print("\nDescription:\n" + (desc if desc else "(empty)"))
    if args.comments:
        comments = (f.get("comment") or {}).get("comments", [])
        print(f"\nComments ({len(comments)}):")
        for c in comments:
            print(f"- {name_of(c.get('author'))} [{short_date(c.get('created'))}]: {adf_to_text(c.get('body')).strip()}")


def cmd_issue_create(args):
    fields = {"project": {"key": args.project}, "issuetype": {"name": args.type}, "summary": args.summary}
    if args.description is not None:
        fields["description"] = text_to_adf(read_maybe_stdin(args.description))
    if args.assignee:
        fields["assignee"] = {"accountId": args.assignee}
    if args.priority:
        fields["priority"] = {"name": args.priority}
    if args.label:
        fields["labels"] = args.label
    if args.parent:
        fields["parent"] = {"key": args.parent}
    fields.update(parse_field_kv(args.field))
    res = api_request("POST", f"/rest/api/{API}/issue", body={"fields": fields})
    if args.json:
        return jdump(res)
    print(res.get("key", res))


def cmd_issue_edit(args):
    fields = {}
    if args.summary:
        fields["summary"] = args.summary
    if args.description is not None:
        fields["description"] = text_to_adf(read_maybe_stdin(args.description))
    if args.assignee:
        fields["assignee"] = {"accountId": args.assignee}
    if args.priority:
        fields["priority"] = {"name": args.priority}
    fields.update(parse_field_kv(args.field))
    update = {}
    if args.add_label or args.remove_label:
        update["labels"] = ([{"add": l} for l in (args.add_label or [])] +
                            [{"remove": l} for l in (args.remove_label or [])])
    if not fields and not update:
        die(EX_USAGE, "nothing to edit (pass --summary/--description/--assignee/--field/--add-label/...)")
    payload = {}
    if fields:
        payload["fields"] = fields
    if update:
        payload["update"] = update
    api_request("PUT", f"/rest/api/{API}/issue/{args.key}", body=payload, expect_json=False)
    print(f"{args.key} updated")


def cmd_issue_comment(args):
