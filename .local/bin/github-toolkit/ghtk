from pathlib import Path

VERSION = "0.1.0"

CONFIG_DIR = Path(os.environ.get("GITHUB_TOOLKIT_CONFIG_DIR", Path.home() / ".config" / "github-toolkit"))
AUTH_FILE = CONFIG_DIR / "auth.json"
CA_CACHE = CONFIG_DIR / "cacert.pem"
CA_MAX_AGE_SEC = 30 * 24 * 3600

API_ROOT = os.environ.get("GITHUB_API_URL", "https://api.github.com").rstrip("/")
GRAPHQL_URL = API_ROOT + "/graphql"
API_VERSION = "2022-11-28"
GH_ACCEPT = "application/vnd.github+json"
DIFF_ACCEPT = "application/vnd.github.v3.diff"
USER_AGENT = f"ghtk/{VERSION}"
DEFAULT_TIMEOUT = 30

EX_OK, EX_USAGE, EX_AUTH, EX_NOTFOUND, EX_API, EX_NET = 0, 1, 2, 3, 4, 5


# --------------------------------------------------------------------------- #
# small utilities
# --------------------------------------------------------------------------- #
def eprint(*a):
    print(*a, file=sys.stderr)


def die(code, msg):
    eprint(f"error: {msg}")
    sys.exit(code)


def jdump(obj):
    print(json.dumps(obj, separators=(",", ":"), ensure_ascii=False))


def read_maybe_stdin(value):
    return sys.stdin.read() if value == "-" else value


def read_body_arg(body, body_file):
    """Resolve a --body / --body-file pair into text (body_file wins; '-' = stdin)."""
    if body_file is not None:
        return sys.stdin.read() if body_file == "-" else Path(body_file).read_text()
    if body is not None:
        return read_maybe_stdin(body)
    return ""


# --------------------------------------------------------------------------- #
# TLS (ported from atlassian-toolkit; verification always ON)
# --------------------------------------------------------------------------- #
def _macos_root_pem():
    if platform.system() != "Darwin":
        return None
    parts = []
    for kc in ("/System/Library/Keychains/SystemRootCertificates.keychain",
               "/Library/Keychains/System.keychain"):
        try:
            out = subprocess.run(["security", "find-certificate", "-a", "-p", kc],
                                 capture_output=True, text=True, timeout=15)
            if out.returncode == 0 and out.stdout:
                parts.append(out.stdout)
        except (OSError, subprocess.SubprocessError):
            continue
    return "\n".join(parts) if parts else None


# Well-known system CA bundle locations, tried when the Python trust store is empty and
# certifi is absent. Covers Debian/Ubuntu, RHEL/Rocky/Fedora, openSUSE, Alpine, and BSD/macOS.
KNOWN_CA_BUNDLE_PATHS = [
    "/etc/ssl/certs/ca-certificates.crt",   # Debian, Ubuntu, Gentoo, Arch
    "/etc/pki/tls/certs/ca-bundle.crt",     # RHEL, Rocky, CentOS, Fedora
    "/etc/pki/tls/cert.pem",                # RHEL/Rocky (alternate)
    "/etc/ssl/ca-bundle.pem",               # openSUSE
    "/etc/ssl/cert.pem",                    # Alpine, BSD, macOS
]


def build_ssl_context():
    """Return an SSLContext with a working CA bundle. Verification is always ON;
    point GITHUB_CA_BUNDLE (or SSL_CERT_FILE) at a PEM file for custom CAs."""
    ctx = ssl.create_default_context()
    for var in ("GITHUB_CA_BUNDLE", "SSL_CERT_FILE", "REQUESTS_CA_BUNDLE"):
        p = os.environ.get(var)
        if p and os.path.exists(p):
            ctx.load_verify_locations(cafile=p)
            return ctx
    if ctx.cert_store_stats().get("x509", 0) > 0:
        return ctx
    try:
        import certifi
        ctx.load_verify_locations(certifi.where())
        return ctx
    except Exception:
        pass
    try:
        if CA_CACHE.exists() and (time.time() - CA_CACHE.stat().st_mtime) < CA_MAX_AGE_SEC:
            ctx.load_verify_locations(cafile=str(CA_CACHE))
            if ctx.cert_store_stats().get("x509", 0) > 0:
                return ctx
    except (OSError, ssl.SSLError):
        pass
    pem = _macos_root_pem()  # macOS: export roots from the system/admin keychains
    if pem:
        ctx.load_verify_locations(cadata=pem)
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            CA_CACHE.write_text(pem)
        except OSError:
            pass
        return ctx
    for path in KNOWN_CA_BUNDLE_PATHS:  # Linux/BSD: load a well-known distro CA bundle
        if os.path.exists(path):
            try:
                ctx.load_verify_locations(cafile=path)
                if ctx.cert_store_stats().get("x509", 0) > 0:
                    return ctx
            except ssl.SSLError:
                continue
    return ctx


# --------------------------------------------------------------------------- #
# auth
# --------------------------------------------------------------------------- #
_TOKEN_CACHE = None  # (token, source)


def _gh_auth_token():
    try:
        out = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    tok = (out.stdout or "").strip()
    return tok if out.returncode == 0 and tok else None


def load_token(require=True):
    """Resolve a GitHub token. Precedence: env -> gh auth token -> auth.json.
    Returns (token, source) or (None, None)."""
    global _TOKEN_CACHE
    if _TOKEN_CACHE is not None:
        return _TOKEN_CACHE
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    source = "env" if token else None
    if not token:
        token = _gh_auth_token()
        source = "gh" if token else None
    if not token and AUTH_FILE.exists():
        try:
            token = json.loads(AUTH_FILE.read_text()).get("token")
            source = "file" if token else None
        except (OSError, json.JSONDecodeError) as e:
            die(EX_AUTH, f"could not read {AUTH_FILE}: {e}")
    if not token:
        if not require:
            return None, None
        die(EX_AUTH, "not authenticated. Set GITHUB_TOKEN, run `gh auth login`, or `ghtk auth login`.")
    _TOKEN_CACHE = (token, source)
    return _TOKEN_CACHE


def save_auth(token):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONFIG_DIR, 0o700)
    except OSError:
        pass
    AUTH_FILE.write_text(json.dumps({"token": token}, indent=2))
    os.chmod(AUTH_FILE, 0o600)


# --------------------------------------------------------------------------- #
# HTTP core (REST + GraphQL + pagination)
# --------------------------------------------------------------------------- #
class ApiHTTPError(Exception):
    def __init__(self, e):
        self.code = e.code
        self.headers = e.headers
        try:
            self.body = e.read().decode("utf-8", "replace")
        except Exception:
            self.body = ""


class ApiNetError(Exception):
    def __init__(self, exc, cert):
        self.exc = exc
        self.cert = cert


def _headers(accept=GH_ACCEPT):
    token, _ = load_token()
    return {"Accept": accept, "Authorization": f"Bearer {token}",
            "X-GitHub-Api-Version": API_VERSION, "User-Agent": USER_AGENT}


def _url(path, params=None):
    url = path if path.startswith("http") else API_ROOT + path
    if params:
        url += "?" + urllib.parse.urlencode(params, doseq=True)
    return url


def _cert_help(e):
    return ("TLS certificate verification failed. This tool auto-loads a CA bundle; "
            "override it with GITHUB_CA_BUNDLE=/path/to/ca.pem . "
            f"({e})")


def _net_help(e):
    reason = getattr(e, "reason", e)
    return (f"network error: {reason}. If this only happens inside a sandbox, "
            "re-run the command outside the sandbox.")


def _rate_limited(e):
    """A 403/429 that is a rate-limit (primary or secondary), so worth retrying."""
    if e.code == 429:
        return True
    if e.code == 403:
        if e.headers.get("Retry-After"):
            return True
        if e.headers.get("X-RateLimit-Remaining") == "0":
            return True
    return False


def _retry_delay(e, attempt):
    ra = e.headers.get("Retry-After")
    if ra and ra.isdigit():
        return min(float(ra), 60)
    reset = e.headers.get("X-RateLimit-Reset")
    if reset and reset.isdigit():
        return min(max(float(reset) - time.time(), 1), 60)
    return 2 ** attempt


def _open(method, url, headers, data=None, timeout=DEFAULT_TIMEOUT):
    """One request with retries. Returns (status, headers_dict, body_bytes).
    Raises ApiHTTPError (non-retryable HTTP) or ApiNetError (TLS/network)."""
    ctx = build_ssl_context()
    for attempt in range(4):
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
                return r.status, dict(r.headers), r.read()
        except urllib.error.HTTPError as e:
            if (e.code in (500, 502, 503, 504) or _rate_limited(e)) and attempt < 3:
                time.sleep(_retry_delay(e, attempt))
                continue
            raise ApiHTTPError(e)
        except ssl.SSLCertVerificationError as e:
            raise ApiNetError(e, cert=True)
        except (urllib.error.URLError, TimeoutError, http.client.HTTPException, ConnectionError) as e:
            # http.client.IncompleteRead / RemoteDisconnected: transient early close on a
            # large response -- retry rather than surfacing a traceback.
            if attempt < 3:
                time.sleep(2 ** attempt)
                continue
            raise ApiNetError(e, cert=False)


def _extract_error_message(body):
    try:
        data = json.loads(body)
    except (json.JSONDecodeError, TypeError):
        return (body or "")[:300]
    if not isinstance(data, dict):
        return ""
    parts = []
    if data.get("message"):
        parts.append(str(data["message"]))
    for err in data.get("errors") or []:
        if isinstance(err, dict):
            detail = err.get("message") or f"{err.get('resource','')}.{err.get('field','')}: {err.get('code','')}"
            parts.append(detail.strip(". "))
        else:
            parts.append(str(err))
    return "; ".join(p for p in parts if p)


def _raise_http(e: ApiHTTPError):
    msg = f"HTTP {e.code}"
    detail = _extract_error_message(e.body)
    if detail:
        msg += f": {detail}"
    if e.code in (401, 403) and not (e.headers.get("X-RateLimit-Remaining") == "0"):
        msg += "  (check `ghtk auth status`; the token may be wrong, expired, or missing a scope)"
    if e.headers.get("X-RateLimit-Remaining") == "0":
        reset = e.headers.get("X-RateLimit-Reset")
        if reset and reset.isdigit():
            msg += f"  (rate limit exhausted; resets in ~{int(float(reset) - time.time())}s)"
    code = {401: EX_AUTH, 403: EX_AUTH, 404: EX_NOTFOUND}.get(e.code, EX_API)
    if e.headers.get("X-RateLimit-Remaining") == "0":
        code = EX_API
    die(code, msg)


def rest(method, path, params=None, body=None, accept=GH_ACCEPT, expect="json", soft=False):
    """REST call. expect: 'json' | 'bytes' | 'full' (returns (status, headers, bytes))."""
    headers = _headers(accept)
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    try:
        status, hdrs, raw = _open(method, _url(path, params), headers, data)
    except ApiHTTPError as e:
        if soft:
            return None
        _raise_http(e)
    except ApiNetError as e:
        if soft:
            return None
        die(EX_NET, _cert_help(e.exc) if e.cert else _net_help(e.exc))
    if expect == "bytes":
        return raw
    if expect == "full":
        return status, hdrs, raw
    return json.loads(raw) if raw else {}


def _post(path, body):
    """POST JSON and return the parsed response, RAISING ApiHTTPError / ApiNetError so the
    caller can discriminate error codes (unlike rest(soft=True), which swallows them)."""
    headers = _headers()
    headers["Content-Type"] = "application/json"
    _status, _hdrs, rawb = _open("POST", _url(path), headers, json.dumps(body).encode())
    return json.loads(rawb) if rawb else {}


def _next_link(link_header):
    if not link_header:
        return None
    for part in link_header.split(","):
        m = re.search(r'<([^>]+)>\s*;\s*rel="next"', part)
        if m:
            return m.group(1)
    return None


def rest_all(path, params=None, accept=GH_ACCEPT, container_key=None, cap=None, soft=False):
    """GET, following Link: rel=next. Returns (items, truncated).
    container_key: for endpoints returning {..., <key>: [...]} (e.g. check_runs)."""
    url = _url(path, params)
    headers = _headers(accept)
    items, truncated = [], False
    while url:
        try:
            status, hdrs, raw = _open("GET", url, headers)
        except ApiHTTPError as e:
            if soft:
                return items, truncated
            _raise_http(e)
        except ApiNetError as e:
            if soft:
                return items, truncated
            die(EX_NET, _cert_help(e.exc) if e.cert else _net_help(e.exc))
        data = json.loads(raw) if raw else ([] if container_key is None else {})
        page = data.get(container_key, []) if container_key else (data if isinstance(data, list) else [])
        items.extend(page)
        if cap and len(items) >= cap:
            items = items[:cap]
            truncated = truncated or bool(_next_link(hdrs.get("Link")))
            break
        url = _next_link(hdrs.get("Link"))
    return items, truncated


def graphql(query, variables=None, soft=False):
    """POST to the GraphQL endpoint. Unwraps `data`, raising on the errors[] array
    (which GitHub returns INSIDE an HTTP 200)."""
    headers = _headers("application/json")
    data = json.dumps({"query": query, "variables": variables or {}}).encode()
    try:
        status, hdrs, raw = _open("POST", GRAPHQL_URL, headers, data)
    except ApiHTTPError as e:
        if soft:
            return None
        _raise_http(e)
    except ApiNetError as e:
        if soft:
            return None
        die(EX_NET, _cert_help(e.exc) if e.cert else _net_help(e.exc))
    payload = json.loads(raw) if raw else {}
    if payload.get("errors"):
        msgs = "; ".join(e.get("message", "") for e in payload["errors"] if isinstance(e, dict))
        if soft:
            return None
        die(EX_API, f"GraphQL error: {msgs or payload['errors']}")
    return payload.get("data") or {}


# --------------------------------------------------------------------------- #
# repo / PR reference resolution
# --------------------------------------------------------------------------- #
def _git(args):
    try:
        out = subprocess.run(["git"] + args, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def _parse_owner_repo(url):
    if not url:
        return None
    m = re.search(r"github\.com[:/]+([^/]+)/(.+?)(?:\.git)?/?$", url.strip())
    if m:
        return m.group(1), m.group(2)
    return None


_REPO_OVERRIDE = None  # set from argv in main(): a universal --repo/-R usable in any position


def resolve_repo(repo_arg):
    """Return (owner, repo) from --repo owner/repo (any position), else the git 'origin' remote."""
    repo_arg = repo_arg or _REPO_OVERRIDE
    if repo_arg:
        if "/" not in repo_arg:
            die(EX_USAGE, f"--repo expects owner/repo, got: {repo_arg}")
        owner, repo = repo_arg.split("/", 1)
        return owner, repo.removesuffix(".git")
    for remote in ("origin", "upstream"):
        got = _parse_owner_repo(_git(["remote", "get-url", remote]))
        if got:
            return got
    die(EX_USAGE, "could not determine the repository. Pass --repo owner/repo, "
                  "or run inside a git checkout with a github.com remote.")


def parse_ref(ref, owner, repo):
    """Parse a PR ref into (owner, repo, number|None). A URL overrides owner/repo."""
    if ref is None:
        return owner, repo, None
    ref = ref.strip()
    m = re.search(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)", ref)
    if m:
        return m.group(1), m.group(2), int(m.group(3))
    m = re.fullmatch(r"#?(\d+)", ref)
    if m:
        return owner, repo, int(m.group(1))
    die(EX_USAGE, f"could not parse a PR reference from: {ref} "
                  "(pass a number, #number, or a .../pull/<n> URL)")


def find_pr_by_branch(owner, repo, branch):
    prs = rest("GET", f"/repos/{owner}/{repo}/pulls",
               params={"head": f"{owner}:{branch}", "state": "all", "per_page": 30})
    if not prs:  # fork head owners differ; fall back to scanning open PRs by head ref
        prs = [p for p in rest("GET", f"/repos/{owner}/{repo}/pulls",
                                params={"state": "open", "per_page": 100})
               if (p.get("head") or {}).get("ref") == branch]
    if not prs:
        die(EX_NOTFOUND, f"no pull request found for branch '{branch}' in {owner}/{repo}")
    prs.sort(key=lambda p: 0 if p.get("state") == "open" else 1)
    return prs[0]


def _url_ref(ref):
    """(owner, repo, number) if ref is a PR/issue URL, else None."""
    m = re.search(r"github\.com/([^/]+)/([^/]+)/(?:pull|issues)/(\d+)", (ref or "").strip())
    return (m.group(1), m.group(2), int(m.group(3))) if m else None


def resolve_pr(args, need_obj=False):
    """Return (owner, repo, number, pr_obj_or_None). Handles URL/number/current-branch.
    A full URL carries owner/repo, so it does not require a git remote."""
    u = _url_ref(getattr(args, "ref", None))
    if u:
        owner, repo, num = u
    else:
        owner, repo = resolve_repo(getattr(args, "repo", None))
        owner, repo, num = parse_ref(getattr(args, "ref", None), owner, repo)
    if num is None:
        branch = _git(["rev-parse", "--abbrev-ref", "HEAD"])
        if not branch or branch == "HEAD":
            die(EX_USAGE, "no PR reference given and no current git branch to discover from")
        pr = find_pr_by_branch(owner, repo, branch)
        return owner, repo, pr["number"], pr
    if need_obj:
        return owner, repo, num, rest("GET", f"/repos/{owner}/{repo}/pulls/{num}")
    return owner, repo, num, None


def pr_summary(pr, owner, repo):
    return {
        "number": pr.get("number"),
        "url": pr.get("html_url"),
        "title": pr.get("title"),
        "branch": (pr.get("head") or {}).get("ref"),
        "baseRef": (pr.get("base") or {}).get("ref"),
        "state": "draft" if pr.get("draft") else pr.get("state"),
        "owner": owner,
        "repo": repo,
        "headSha": (pr.get("head") or {}).get("sha"),
        "author": (pr.get("user") or {}).get("login"),
    }


# --------------------------------------------------------------------------- #
# commands: pr - get / diff / files
# --------------------------------------------------------------------------- #
def cmd_pr_get(args):
    owner, repo, num, pr = resolve_pr(args, need_obj=True)
    if args.raw:
        return jdump(pr)
    out = pr_summary(pr, owner, repo)
    if args.json:
        return jdump(out)
    print(f"#{out['number']}  {out['state']}  {out['title']}")
    print(f"branch:  {out['branch']} -> {out['baseRef']}")
    print(f"author:  {out['author']}    head: {(out['headSha'] or '')[:12]}")
    print(f"url:     {out['url']}")


def cmd_pr_diff(args):
    owner, repo, num, _ = resolve_pr(args)
    if args.name_only:
        files, truncated = rest_all(f"/repos/{owner}/{repo}/pulls/{num}/files", params={"per_page": 100})
        names = [f.get("filename") for f in files]
        if args.json:
            return jdump({"files": names, "truncated": truncated})
        for n in names:
            print(n)
        if truncated:
            eprint("warning: file list truncated")
        return
    diff = rest("GET", f"/repos/{owner}/{repo}/pulls/{num}", accept=DIFF_ACCEPT, expect="bytes")
    if args.json:
        return jdump({"diff": diff.decode("utf-8", "replace")})
    sys.stdout.buffer.write(diff)
    if diff and not diff.endswith(b"\n"):
        sys.stdout.write("\n")


def cmd_pr_files(args):
    owner, repo, num, _ = resolve_pr(args)
    files, truncated = rest_all(f"/repos/{owner}/{repo}/pulls/{num}/files", params={"per_page": 100})
    out = [{"path": f.get("filename"), "status": f.get("status"),
            "additions": f.get("additions"), "deletions": f.get("deletions")} for f in files]
    if args.json:
        return jdump({"files": out, "count": len(out), "truncated": truncated})
    for f in out:
        print(f"{f['status']:<9} +{f['additions']:<5} -{f['deletions']:<5} {f['path']}")
    print(f"({len(out)} file{'s' if len(out) != 1 else ''}{', truncated' if truncated else ''})")


# --------------------------------------------------------------------------- #
# commands: pr - threads (GraphQL)
# --------------------------------------------------------------------------- #
_THREADS_QUERY = """
query($owner:String!,$repo:String!,$number:Int!,$cursor:String){
  repository(owner:$owner,name:$repo){
    pullRequest(number:$number){
      reviewThreads(first:100, after:$cursor){
        pageInfo{ hasNextPage endCursor }
        nodes{
          id isResolved isOutdated path line startLine diffSide
          comments(first:100){
            pageInfo{ hasNextPage }
            nodes{ id databaseId body createdAt author{ login __typename } }
          }
        }
      }
    }
  }
}
"""


def _fetch_threads(owner, repo, number):
    threads, cursor = [], None
    while True:
        data = graphql(_THREADS_QUERY, {"owner": owner, "repo": repo, "number": number, "cursor": cursor})
        pr = ((data.get("repository") or {}).get("pullRequest")) or {}
        rt = pr.get("reviewThreads") or {}
        threads.extend(rt.get("nodes") or [])
        page = rt.get("pageInfo") or {}
        if page.get("hasNextPage"):
            cursor = page.get("endCursor")
        else:
            break
    return threads


def cmd_pr_threads(args):
    owner, repo, num, _ = resolve_pr(args)
    raw_threads = _fetch_threads(owner, repo, num)
    out = []
    for t in raw_threads:
        if args.unresolved_only and t.get("isResolved"):
            continue
        if not args.include_outdated and t.get("isOutdated"):
            continue
        cwrap = t.get("comments") or {}
        comments = cwrap.get("nodes") or []
        bodies = [c.get("body") or "" for c in comments]
        first_author = ((comments[0].get("author") or {}).get("login") if comments else "") or ""
        is_mine = bool(args.marker) and any(args.marker in b for b in bodies)
        if args.mine_only and not is_mine:
            continue
        if args.author_substr and args.author_substr.lower() not in first_author.lower():
            continue
        out.append({
            "id": t.get("id"),
            "isResolved": t.get("isResolved"),
            "isOutdated": t.get("isOutdated"),
            "path": t.get("path"),
            "line": t.get("line"),
            "startLine": t.get("startLine"),
            "diffSide": t.get("diffSide"),
            "isMine": is_mine,
            "commentsTruncated": bool((cwrap.get("pageInfo") or {}).get("hasNextPage")),
            "comments": [{
                "id": c.get("id"),
                "databaseId": c.get("databaseId"),
                "author": (c.get("author") or {}).get("login"),
                "isBot": (c.get("author") or {}).get("__typename") == "Bot",
                "createdAt": c.get("createdAt"),
                "body": c.get("body"),
            } for c in comments],
        })
    if args.json:
        return jdump({"threads": out, "count": len(out)})
    if not out:
        print("(no matching threads)")
        return
    for t in out:
        flags = []
        if t["isResolved"]:
            flags.append("resolved")
        if t["isOutdated"]:
            flags.append("outdated")
        loc = f"{t['path']}:{t['line']}" if t["path"] else "(no location)"
        print(f"{t['id']}  {loc}  {'[' + ','.join(flags) + '] ' if flags else ''}({len(t['comments'])} comment(s))")
        for c in t["comments"]:
            first = (c["body"] or "").strip().splitlines()[0] if c["body"] else ""
            print(f"    - {c['author']}{' (bot)' if c['isBot'] else ''}: {first[:120]}")


