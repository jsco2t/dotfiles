    if not results:
        print("(no results)")
        return
    for r in results:
        c = r.get("content", {})
        title = c.get("title") or r.get("title", "")
        print(f"{c.get('id','-'):<12} {c.get('type',''):<8} {title}")


def resolve_space_id(key):
    if str(key).isdigit():
        return str(key)
    res = api_request("GET", "/wiki/api/v2/spaces", params={"keys": key, "limit": 1})
    results = res.get("results", [])
    if not results:
        die(EX_NOTFOUND, f"no Confluence space with key: {key}")
    return str(results[0]["id"])


def cmd_conf_create(args):
    body_text = read_maybe_stdin(args.body) if args.body is not None else ""
    payload = {"spaceId": resolve_space_id(args.space), "status": "current", "title": args.title,
               "body": {"representation": "atlas_doc_format", "value": json.dumps(text_to_adf(body_text))}}
    if args.parent:
        payload["parentId"] = str(args.parent)
    res = api_request("POST", "/wiki/api/v2/pages", body=payload)
    if args.json:
        return jdump(res)
    print(f"created page {res.get('id')}: {res.get('title')}")


def cmd_conf_update(args):
    if args.title is None and args.body is None:
        die(EX_USAGE, "nothing to update (pass --title and/or --body)")
    cur = api_request("GET", f"/wiki/api/v2/pages/{args.id}", params={"body-format": "atlas_doc_format"})
    version = ((cur.get("version") or {}).get("number") or 1) + 1
    title = args.title if args.title is not None else cur.get("title")
    if args.body is not None:  # replace body
        value = json.dumps(text_to_adf(read_maybe_stdin(args.body)))
    else:  # title-only change: preserve the existing body (v2 update requires body)
        value = (cur.get("body", {}).get("atlas_doc_format") or {}).get("value") or json.dumps(text_to_adf(""))
    payload = {"id": str(args.id), "status": "current", "title": title,
               "body": {"representation": "atlas_doc_format", "value": value},
               "version": {"number": version}}
    res = api_request("PUT", f"/wiki/api/v2/pages/{args.id}", body=payload)
    if args.json:
        return jdump(res)
    print(f"updated page {args.id} (version {version})")


def cmd_conf_comment(args):
    res = api_request("POST", "/wiki/api/v2/footer-comments",
                      body={"pageId": str(args.page),
                            "body": {"representation": "atlas_doc_format",
                                     "value": json.dumps(text_to_adf(read_maybe_stdin(args.body)))}})
    if args.json:
        return jdump(res)
    print(f"comment added to page {args.page} (id {res.get('id')})")


