                                 os.environ.get("ATLASSIAN_TOOLKIT_CONFIG_DIR",
                                                Path.home() / ".config" / "atlassian-toolkit")))
AUTH_FILE = CONFIG_DIR / "auth.json"
CA_CACHE = CONFIG_DIR / "cacert.pem"
CA_MAX_AGE_SEC = 30 * 24 * 3600

API = "3"
DEFAULT_TIMEOUT = 30
DEFAULT_SEARCH_LIMIT = 25
CONFLUENCE_MAX_CHARS = 4000
DEFAULT_ISSUE_FIELDS = ["summary", "status", "issuetype", "priority", "assignee", "reporter", "labels", "updated"]
DEFAULT_SEARCH_FIELDS = ["summary", "status", "issuetype", "assignee", "updated"]

EX_OK, EX_USAGE, EX_AUTH, EX_NOTFOUND, EX_API, EX_NET = 0, 1, 2, 3, 4, 5


# --------------------------------------------------------------------------- #
# small utilities
# --------------------------------------------------------------------------- #
def eprint(*a):
    print(*a, file=sys.stderr)


def die(code, msg):
    eprint(f"error: {msg}")
    sys.exit(code)


def jdump(obj):
    print(json.dumps(obj, separators=(",", ":"), ensure_ascii=False))


def read_maybe_stdin(value):
    return sys.stdin.read() if value == "-" else value


def parse_field_kv(items):
    out = {}
    for it in items or []:
        if "=" not in it:
            die(EX_USAGE, f"--field expects key=value, got: {it}")
        k, v = it.split("=", 1)
        try:
            out[k] = json.loads(v)
        except json.JSONDecodeError:
            out[k] = v
    return out


def truncate(text, full):
    if full or len(text) <= CONFLUENCE_MAX_CHARS:
        return text
    return text[:CONFLUENCE_MAX_CHARS] + f"\n\n... [truncated {len(text) - CONFLUENCE_MAX_CHARS} of {len(text)} chars; use --full for all]"


# --------------------------------------------------------------------------- #
# auth / config
# --------------------------------------------------------------------------- #
def normalize_base_url(site):
    site = site.strip().rstrip("/")
    if site.startswith(("http://", "https://")):
        return site
    return "https://" + site


def load_auth(require=True):
    site = os.environ.get("JIRA_SITE") or os.environ.get("ATLASSIAN_SITE")
    email = os.environ.get("JIRA_EMAIL") or os.environ.get("ATLASSIAN_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN") or os.environ.get("ATLASSIAN_API_TOKEN")
    if not (site and email and token) and AUTH_FILE.exists():
        try:
            d = json.loads(AUTH_FILE.read_text())
        except (OSError, json.JSONDecodeError) as e:
            die(EX_AUTH, f"could not read {AUTH_FILE}: {e}")
        site = site or d.get("site")
        email = email or d.get("email")
        token = token or d.get("token")
    if not (site and email and token):
        if not require:
            return None, None, None
        die(EX_AUTH, "not authenticated. Run: atlassian auth login  "
                     "(or set ATLASSIAN_SITE, ATLASSIAN_EMAIL, ATLASSIAN_API_TOKEN)")
    return normalize_base_url(site), email, token


def save_auth(base_url, email, token):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONFIG_DIR, 0o700)
    except OSError:
        pass
    AUTH_FILE.write_text(json.dumps({"site": base_url, "email": email, "token": token}, indent=2))
    os.chmod(AUTH_FILE, 0o600)


# --------------------------------------------------------------------------- #
# TLS
# --------------------------------------------------------------------------- #
def _macos_root_pem():
    if platform.system() != "Darwin":
        return None
    parts = []
    for kc in ("/System/Library/Keychains/SystemRootCertificates.keychain",
               "/Library/Keychains/System.keychain"):
        try:
            out = subprocess.run(["security", "find-certificate", "-a", "-p", kc],
                                 capture_output=True, text=True, timeout=15)
            if out.returncode == 0 and out.stdout:
                parts.append(out.stdout)
        except (OSError, subprocess.SubprocessError):
            continue
    return "\n".join(parts) if parts else None


# Well-known system CA bundle locations, tried when the Python trust store is empty and
# certifi is absent. Covers Debian/Ubuntu, RHEL/Rocky/Fedora, openSUSE, Alpine, and BSD/macOS.
KNOWN_CA_BUNDLE_PATHS = [
    "/etc/ssl/certs/ca-certificates.crt",   # Debian, Ubuntu, Gentoo, Arch
    "/etc/pki/tls/certs/ca-bundle.crt",     # RHEL, Rocky, CentOS, Fedora
    "/etc/pki/tls/cert.pem",                # RHEL/Rocky (alternate)
    "/etc/ssl/ca-bundle.pem",               # openSUSE
    "/etc/ssl/cert.pem",                    # Alpine, BSD, macOS
]


def build_ssl_context():
    """Return an SSLContext with a working CA bundle. Verification is always ON;
    point ATLASSIAN_CA_BUNDLE at a PEM file for custom CAs."""
    ctx = ssl.create_default_context()
    for var in ("ATLASSIAN_CA_BUNDLE", "JIRA_CA_BUNDLE", "SSL_CERT_FILE", "REQUESTS_CA_BUNDLE"):
        p = os.environ.get(var)
        if p and os.path.exists(p):
            ctx.load_verify_locations(cafile=p)
            return ctx
    if ctx.cert_store_stats().get("x509", 0) > 0:
        return ctx
    try:
        import certifi
        ctx.load_verify_locations(certifi.where())
        return ctx
    except Exception:
        pass
    try:
        if CA_CACHE.exists() and (time.time() - CA_CACHE.stat().st_mtime) < CA_MAX_AGE_SEC:
            ctx.load_verify_locations(cafile=str(CA_CACHE))
            if ctx.cert_store_stats().get("x509", 0) > 0:
                return ctx
    except (OSError, ssl.SSLError):
        pass
    pem = _macos_root_pem()  # macOS: export roots from the system/admin keychains
    if pem:
        ctx.load_verify_locations(cadata=pem)
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            CA_CACHE.write_text(pem)
        except OSError:
            pass
        return ctx
    for path in KNOWN_CA_BUNDLE_PATHS:  # Linux/BSD: load a well-known distro CA bundle
        if os.path.exists(path):
            try:
                ctx.load_verify_locations(cafile=path)
                if ctx.cert_store_stats().get("x509", 0) > 0:
                    return ctx
            except ssl.SSLError:
                continue
    return ctx


# --------------------------------------------------------------------------- #
# HTTP
# --------------------------------------------------------------------------- #
def _cert_help(e):
    return ("TLS certificate verification failed. This tool auto-loads a CA bundle; "
            "override it with ATLASSIAN_CA_BUNDLE=/path/to/ca.pem . "
            "If the failure only happens inside a sandbox, re-run the command outside it. "
            f"({e})")


def _net_help(e):
    reason = getattr(e, "reason", e)
    return (f"network error: {reason}. If this only happens inside a sandbox, "
            "re-run the command outside the sandbox.")


def _extract_error_message(body):
    try:
        data = json.loads(body)
    except (json.JSONDecodeError, TypeError):
        return body[:300] if body else ""
    if isinstance(data, dict):
        parts = list(data.get("errorMessages") or [])                       # Jira
        parts += [f"{k}: {v}" for k, v in (data.get("errors") or {}).items()
                  if not isinstance(data.get("errors"), list)]
        if isinstance(data.get("errors"), list):                            # Confluence v2
            parts += [e.get("title", "") for e in data["errors"] if isinstance(e, dict)]
        if data.get("message"):                                             # Confluence v1
            parts.append(str(data["message"]))
        return "; ".join(p for p in parts if p)
    return ""


def _http_error(e):
    body = ""
    try:
        body = e.read().decode("utf-8", "replace")
    except Exception:
        pass
    msg = f"HTTP {e.code}"
    detail = _extract_error_message(body)
    if detail:
        msg += f": {detail}"
    if e.code in (401, 403):
        msg += "  (check `atlassian auth status`; the API token may be wrong or expired)"
    code = {401: EX_AUTH, 403: EX_AUTH, 404: EX_NOTFOUND}.get(e.code, EX_API)
    die(code, msg)


def api_request(method, path, params=None, body=None, timeout=DEFAULT_TIMEOUT, expect_json=True, soft=False):
    """Make an Atlassian API request. On error: die(), or if soft=True return None."""
    base_url, email, token = load_auth()
    url = base_url + path
    if params:
        url += "?" + urllib.parse.urlencode(params, doseq=True)
    headers = {"Accept": "application/json",
               "Authorization": "Basic " + base64.b64encode(f"{email}:{token}".encode()).decode()}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    ctx = build_ssl_context()

    last_err = None
    for attempt in range(4):
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
                raw = r.read()
                if not expect_json:
                    return raw
                return json.loads(raw) if raw else {}
        except urllib.error.HTTPError as e:
            if e.code in (429, 500, 502, 503, 504) and attempt < 3:
                ra = e.headers.get("Retry-After")
                time.sleep(float(ra) if (ra and ra.isdigit()) else 2 ** attempt)
                continue
            if soft:
                eprint(f"warning: {method} {path} -> HTTP {e.code}")
                return None
            _http_error(e)
        except ssl.SSLCertVerificationError as e:
            if soft:
                return None
            die(EX_NET, _cert_help(e))
        except (urllib.error.URLError, TimeoutError) as e:
            last_err = e
            if attempt < 3:
                time.sleep(2 ** attempt)
                continue
            if soft:
                eprint(f"warning: {method} {path} -> {getattr(e, 'reason', e)}")
                return None
            die(EX_NET, _net_help(e))
    if soft:
        return None
    die(EX_NET, _net_help(last_err))


# --------------------------------------------------------------------------- #
# ADF -> text  /  text -> ADF  /  HTML -> text
# --------------------------------------------------------------------------- #
def adf_to_text(node):
    if node is None:
        return ""
    if isinstance(node, str):
        return node
    t = node.get("type")
    content = node.get("content", [])

    def kids(sep=""):
        return sep.join(adf_to_text(c) for c in content)

    if t == "text":
        text = node.get("text", "")
        for mark in node.get("marks", []):
            mt = mark.get("type")
            if mt == "code":
                text = f"`{text}`"
            elif mt == "link":
                href = mark.get("attrs", {}).get("href", "")
                text = f"{text} ({href})" if href else text
        return text
    if t == "hardBreak":
        return "\n"
    if t == "paragraph":
        return kids()
    if t == "heading":
        level = node.get("attrs", {}).get("level", 1)
        return "#" * max(1, int(level)) + " " + kids()
    if t in ("bulletList", "orderedList"):
        lines = []
        ordered = t == "orderedList"
        for i, item in enumerate(content, 1):
            marker = f"{i}. " if ordered else "- "
            lines.append(marker + adf_to_text(item).strip())
        return "\n".join(lines)
    if t == "listItem":
        return kids("\n")
    if t == "codeBlock":
        return "```\n" + kids() + "\n```"
    if t == "blockquote":
        return "> " + kids("\n").replace("\n", "\n> ")
    if t == "rule":
        return "---"
    if t == "mention":
        return "@" + node.get("attrs", {}).get("text", "").lstrip("@")
    if t == "emoji":
        return node.get("attrs", {}).get("text", "") or node.get("attrs", {}).get("shortName", "")
    if t in ("inlineCard", "blockCard"):
        return node.get("attrs", {}).get("url", "")
    if t == "table":
        return "\n".join(adf_to_text(c) for c in content)
    if t == "tableRow":
        return " | ".join(adf_to_text(c).strip() for c in content)
    if t in ("tableCell", "tableHeader"):
        return kids(" ")
    if t == "doc":
        return "\n\n".join(adf_to_text(c) for c in content).strip()
    if content:
        block = any(isinstance(c, dict) and c.get("type") in
                    ("paragraph", "heading", "bulletList", "orderedList", "codeBlock",
                     "blockquote", "rule", "table") for c in content)
        return ("\n\n" if block else "").join(adf_to_text(c) for c in content)
    return ""


def text_to_adf(text):
    content = []
    for block in text.replace("\r\n", "\n").split("\n\n"):
        block = block.strip("\n")
        if block == "":
            continue
        para = {"type": "paragraph", "content": []}
        lines = block.split("\n")
        for i, line in enumerate(lines):
            if line:
                para["content"].append({"type": "text", "text": line})
            if i < len(lines) - 1:
                para["content"].append({"type": "hardBreak"})
        if not para["content"]:
            para["content"].append({"type": "text", "text": ""})
        content.append(para)
    if not content:
        content = [{"type": "paragraph", "content": [{"type": "text", "text": text or ""}]}]
    return {"type": "doc", "version": 1, "content": content}


def html_to_text(s):
    """Crude Confluence storage-format (XHTML) to plain text. Ugly but readable."""
    if not s:
        return ""
    s = re.sub(r"(?i)<br\s*/?>", "\n", s)
    s = re.sub(r"(?i)</(p|div|tr|h[1-6])>", "\n\n", s)
    s = re.sub(r"(?i)<li[^>]*>", "\n- ", s)
    s = re.sub(r"(?i)</t[dh]>", " | ", s)
    s = re.sub(r"<[^>]+>", "", s)
    s = html.unescape(s)
    s = re.sub(r"[ \t]+\n", "\n", s)
    s = re.sub(r"\n{3,}", "\n\n", s)
    return s.strip()


# --------------------------------------------------------------------------- #
# formatting helpers
# --------------------------------------------------------------------------- #
def name_of(field):
    if isinstance(field, dict):
        return field.get("displayName") or field.get("name") or field.get("value") or ""
    return field or ""


def short_date(s):
    return (s or "")[:10]


def issue_line(issue):
    f = issue.get("fields", {})
    return f"{issue.get('key','?'):<14} {name_of(f.get('status')):<14} {f.get('summary','')}"


def parse_confluence_id(s):
    s = s.strip()
    if s.isdigit():
        return s
    m = re.search(r"/pages/(\d+)", s)
    if m:
        return m.group(1)
    die(EX_USAGE, f"could not parse a Confluence page id from: {s} "
                  "(pass a numeric id or a .../wiki/spaces/.../pages/<id>/... URL)")


