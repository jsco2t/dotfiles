def cmd_search_generic(args):
    q = args.query
    jr = api_request("POST", f"/rest/api/{API}/search/jql",
                     body={"jql": f'text ~ "{q}"', "maxResults": args.limit,
                           "fields": ["summary", "status", "issuetype"]}, soft=True)
    issues = (jr or {}).get("issues", [])
    cr = api_request("GET", "/wiki/rest/api/search",
                     params={"cql": f'text ~ "{q}"', "limit": args.limit}, soft=True)
    pages = (cr or {}).get("results", [])
    if args.json:
        return jdump({"jira": [{"key": i.get("key"), "summary": i.get("fields", {}).get("summary")} for i in issues],
                      "confluence": [{"id": r.get("content", {}).get("id"),
                                      "title": r.get("content", {}).get("title") or r.get("title")} for r in pages]})
    print("Jira:")
    for i in issues:
        print("  " + issue_line(i))
    if not issues:
        print("  (none)")
    print("Confluence:")
    for r in pages:
        c = r.get("content", {})
        print(f"  {c.get('id','-'):<12} {c.get('title') or r.get('title','')}")
    if not pages:
        print("  (none)")


