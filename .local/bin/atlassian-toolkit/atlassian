def cmd_doctor(args):
    if args.fix_ca:
        try:
            CA_CACHE.unlink()
            print(f"removed cached CA bundle {CA_CACHE}")
        except FileNotFoundError:
            print("no cached CA bundle to remove")
        except OSError as e:
            eprint(f"could not remove {CA_CACHE}: {e}")
    print(f"atlassian-toolkit {VERSION}")
    print(f"python:  {platform.python_version()} ({platform.system()})")
    ctx = build_ssl_context()
    n = ctx.cert_store_stats().get("x509", 0)
    if n:
        print(f"TLS CA:  {n} certificate(s) loaded")
    else:
        print("TLS CA:  0 certificates  [!] empty trust store -- HTTPS will fail")
        print("         fix: install CA certs (Debian: apt-get install -y ca-certificates; "
              "Rocky/RHEL: dnf install -y ca-certificates),")
        print("              or `pip install certifi`, or set ATLASSIAN_CA_BUNDLE=/path/to/ca-bundle.crt")
    base_url, email, token = load_auth(require=False)
    if not (base_url and email and token):
        print("auth:    not configured  -> run: atlassian auth login")
        return
    print(f"site:    {base_url}")
    print(f"email:   {email}")
    me = api_request("GET", f"/rest/api/{API}/myself", soft=True)
    print(f"jira:    OK -- {me.get('displayName')} ({me.get('accountId')})" if me else "jira:    FAILED (see warning above)")
    cf = api_request("GET", "/wiki/api/v2/spaces", params={"limit": 1}, soft=True)
    print("confluence: OK" if cf is not None else "confluence: FAILED (see warning above)")


